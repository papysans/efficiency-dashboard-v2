# efficiency-dashboard docker-compose 部署变量（内网环境）
# 用法：在 compose/ 目录下 docker compose --env-file .env up -d
# 离线流程见 README.md：本机 build.sh 构建 → save.sh 导出 tar → 内网 docker load → up

# ---- 镜像（CI 推到 ghcr 的 beta 多架构镜像；内网拉 ghcr → save → load 后 compose 按此引用）----
# 若用本机 build.sh 构建，把下面改成本地 tag 即可。
VERSION=beta-v1.1.3
IMAGE_SERVER=ghcr.io/papysans/efficiency-dashboard-server:beta-v1.1.3-amd64
IMAGE_KBCLI=ghcr.io/papysans/efficiency-dashboard-kbcli:beta-v1.1.3-amd64
IMAGE_NGINX=ghcr.io/papysans/efficiency-dashboard-portal:beta-v1.1.3-amd64
IMAGE_POSTGRES=postgres:15-alpine

# ---- 对外端口（内网主机）----
# 与旧服务共存：若旧服务占了这些端口，改成不冲突的端口即可（项目名已隔离容器/网络/卷）。
PORT_PORTAL=8088
PORT_BACKEND=9990
PORT_POSTGRES=5432
PORT_KBCLI=8080

# ---- 数据源：上游只读映射的两个 mnt（位置不固定时改这里）----
# task = 对话原始数据（mnt/user-indicator/raw/task）
# repo = commit 原始数据（"mnt 2"/user-indicator/raw/repo）
DATA_TASK_DIR=/mnt/prod_env/user-indicator/raw/task
DATA_REPO_DIR=/mnt/prod_env/user-indicator/raw/repo

# ---- Postgres ----
# POSTGRES_DB 用 postgres（默认库）：由 initdb.d/10-create-db.sql 建 costrict_stat，
# 避免镜像自动建库与脚本 CREATE DATABASE 冲突。应用连接的是 costrict_stat。
POSTGRES_DB=postgres
POSTGRES_USER=postgres
PASSWORD_POSTGRES=1
