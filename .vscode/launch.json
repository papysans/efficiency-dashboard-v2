    "version": "0.2.0",
    "configurations": [
        {
            "name": "comdig CLI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/comdig",
            "env": {},
            "args": ["-s", "深信服", "-tpl", "xueqiu", "-p", "h1", "-from", "2023Q1", "-to", "2026Q2"],
        },
        {
            "name": "backend",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "command": "pwd && go run ."
        },
        {
            "name": "frontend-react dev",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend-react",
            "command": "npm run dev -- --host 0.0.0.0"
        }
    ]
}